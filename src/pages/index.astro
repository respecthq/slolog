---
import Editorial from '../layouts/Editorial.astro';
import {url} from '../lib/url';
import {icons} from '../lib/icons';
import {APP_STORE_URL_JP} from '../lib/store';
import {getCollection} from 'astro:content';
import {topics} from '../lib/topics';
// TOPICS：機種ページへの入口。導入日は機種 md の released から。
// 「予定」は付けない（サイトは週1で作り直すので、ビルドした日で予定／済みを分けると導入日を過ぎても「予定」が残る）
const machineData = new Map((await getCollection('machines', ({data}) => !data.draft)).map((m) => [m.id, m.data]));
const buildDay = new Date().toISOString().slice(0, 10);
const thisYear = buildDay.slice(0, 4);
const releaseLabel = (r?: string) => {
  const m = /^(\d{4})-(\d{2})(?:-(\d{2}))?/.exec(r ?? '');
  if (!m) return '';
  const date = `${m[1] === thisYear ? '' : `${m[1]}年`}${Number(m[2])}月${m[3] ? `${Number(m[3])}日` : ''}`;
  return `${date}導入`;
};
const topicCards = topics.filter((t) => machineData.has(t.slug)).map((t) => ({...t, release: releaseLabel(String(machineData.get(t.slug)?.released ?? ''))}));
---
<Editorial title="スロログ｜記録から、判断へ。パチスロ収支アプリ" description="収支を残すだけじゃない。次の立ち回りに、記録を使う。実戦記録・収支グラフ・小役カウンターをひとつにしたiPhoneアプリ。記録と基本の集計は無料、広告なし。Proでは、自分の期待値表を使った振り返りも。" home>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">パチスロ収支・立ち回りアプリ</p>
        <h1 id="hero-title"><img src={url("editorial/assets/logo.png")} alt="スロログ" width="400" height="133"></h1>
        <p class="hero-headline">記録から、<em>判断へ。</em></p>
        <p class="hero-lead">打った結果を、次の立ち回りに。<br>収支も、気づきも、自分の基準も。スロログに残そう。</p>
        <a class="button primary" href={url("machines/")}>新台・機種情報を見る <img src={url("editorial/assets/chevron-right.svg")} alt=""></a>
        <a class="store-badge hero-badge" href={APP_STORE_URL_JP} target="_blank" rel="noopener" aria-label="App Storeからダウンロード"><img src={url("editorial/assets/badge-appstore.svg")} alt="App Storeからダウンロード" width="136" height="50"></a>
        <p class="release-status">iPhone向け / 記録と基本の集計は無料</p>
      </div>
      <div class="hero-stage">
        <div class="stage-band" aria-hidden="true"></div>
        <div class="hero-devices">
          <div class="phone phone-left"><img src={url("editorial/assets/graph.webp")} alt="累積収支のグラフ画面" width="900" height="1955"></div>
          <div class="phone phone-main"><img src={url("editorial/assets/home.webp")} alt="スロログのホーム。今月の収支、勝率、実戦ツールをまとめて確認" width="900" height="1955" fetchpriority="high"></div>
          <div class="phone phone-right"><img src={url("editorial/assets/calendar.webp")} alt="日ごとの収支を確認できるカレンダー画面" width="900" height="1955"></div>
          <img class="kinana" src={url("editorial/assets/kinana.webp")} width="740" height="1110" alt="回胴キナナのキャラクター" fetchpriority="high">
          <div class="stage-label"><span>YOUR PLAY.<br>YOUR RECORD.</span><small>powered by 回胴キナナ</small></div>
        </div>
      </div>
    </section>
    <div class="trust-strip"><span><img src={url("editorial/assets/check.svg")} alt="">記録と基本の集計は無料</span><span><img src={url("editorial/assets/check.svg")} alt="">広告なし</span><span><img src={url("editorial/assets/shield-check.svg")} alt="">記録・写真は端末内に保存</span></div>

    {topicCards.length > 0 && <section class="section topics" id="topics" aria-labelledby="topics-title"><div class="topics-heading"><div><p class="eyebrow">TOPICS</p><h2 id="topics-title">新台・注目機種</h2></div><a class="text-link" href={url("machines/")}>機種情報をすべて見る <img src={url("editorial/assets/chevron-right.svg")} alt=""></a></div><ul class="topic-list">
      {topicCards.map((t) => <li><a class="topic-card" href={url(`machines/${t.slug}/`)}><img src={url(t.image)} width="716" height="511" loading="lazy" decoding="async" alt={`${t.title} の筐体とロゴ`}><div class="topic-body">{t.release && <span class="topic-chip">{t.release}</span>}<h3>{t.title}</h3><p>{t.text}</p></div></a></li>)}
    </ul></section>}

    <section class="section features" id="features">
      <div class="section-heading"><p class="eyebrow"><b>01</b> THINK. RECORD. REVIEW.</p><h2>打つ前も、打った後も。<br>自分の立ち回りを、<em>ひとつに。</em></h2><p>狙い目を考えて、実戦を残し、結果を振り返る。<br>毎日の記録を、自分の判断に使える形へ。</p></div>
      <div class="feature-tabs" role="tablist" aria-label="アプリの機能"><button role="tab" id="tab-ev" aria-controls="feature-panel" aria-selected="true" data-feature="ev">01 <span>狙い目を考える</span></button><button role="tab" id="tab-record" aria-controls="feature-panel" aria-selected="false" tabindex="-1" data-feature="record">02 <span>実戦を残す</span></button><button role="tab" id="tab-graph" aria-controls="feature-panel" aria-selected="false" tabindex="-1" data-feature="graph">03 <span>結果を振り返る</span></button></div>
      <div class="feature-panel" id="feature-panel" role="tabpanel" aria-labelledby="tab-ev" tabindex="0">
        <div class="feature-copy"><span class="feature-label" id="feature-label">期待値表 / PRO</span><h3 id="feature-title">自分の表で、<br>自分の基準を。</h3><p id="feature-description">信頼する期待値表を取り込んで、基準金額「マイボーダー」を設定。打ち始めゲーム数の期待値や、基準を満たす狙い目ゲーム数の目安を確認できます。</p><ul id="feature-list"><li>表を貼り付け、またはファイルから取り込み</li><li>対応する表なら、ホールの交換率・貸メダルに合わせて換算</li><li>実在機種の期待値表は、ご自身で用意</li><li>架空のサンプル機種では、見本の表をProなしで体験</li></ul><a class="text-link" href={url("#plans")}>無料とProの違いを見る <img src={url("editorial/assets/chevron-right.svg")} alt=""></a></div>
        <div class="feature-screen"><span class="screen-word" aria-hidden="true" id="screen-word">THINK</span><div class="phone"><img id="feature-image" src={url("editorial/assets/ev.webp")} alt="取り込んだ期待値表から、期待値と狙い目ゲーム数の目安を確認する画面" width="900" height="1955" loading="lazy"></div></div>
      </div>
      <p class="image-note">画面はイメージです。機種・店舗・実戦記録・数値は説明用のサンプルです。表示内容はアプリのバージョンや設定によって異なります。</p>
    </section>

    <section class="tools section" id="tools"><div class="tools-heading"><p class="eyebrow"><b>02</b> IN YOUR POCKET</p><h2>ホールでほしい道具を、<br>ポケットに。</h2></div><div class="tool-grid">
      <article><img src={url("editorial/assets/notebook-pen.svg")} alt=""><h3>台メモ</h3><p>気になる台のゲーム数を、その場でメモ。当日・前日・前々日、最大3日分の入力G数をまとめて確認できます。</p></article>
      <article><img src={url("editorial/assets/cherry.svg")} alt=""><h3>小役カウンター</h3><p>数えたい役を、自分で並べる。対応機種の専用カウンターなら、公表ボーナス確率による設定推測も無料です。</p></article>
      <article><img src={url("editorial/assets/timer.svg")} alt=""><h3>打ち始めタイマー</h3><p>打つ前にワンタップ。実戦時間を記録につなげて、収支だけでなく実戦時給も振り返れます。</p></article>
      <article><img src={url("editorial/assets/hard-drive-download.svg")} alt=""><h3>写真込みバックアップ</h3><p>記録も写真も、ZIPにまとめて手元に。対応形式のCSVからの乗り換えにも対応しています。</p></article>
    </div><p class="image-note">設定推測は対応する専用カウンターのみ。確率に基づく参考値で、実際の設定を保証するものではありません。</p></section>

    <section class="review-band"><div class="section review-inner"><div><p class="eyebrow"><b>03</b> MAKE IT YOUR STANDARD</p><h2>その基準で打った結果を、<br><em>自分の記録で見てみよう。</em></h2><p>打ち始めゲーム数の期待値が、マイボーダー以上だった実戦と、未満だった実戦。成績を分けて、自分の基準と結果の関係を振り返れます。</p><span class="pro-tag">スロログ Pro / マイボーダー検証</span><p>Proでは、対象の実戦の期待値と実際の収支を、累計グラフで並べて確認することもできます。</p><p class="fine-print">取り込んだ表と設定条件に基づく参考値です。収支や利益を保証するものではありません。</p></div><figure class="kensho-card" aria-label="マイボーダー検証の画面例">
        <figcaption class="k-head"><span class="k-ico" set:html={icons.scale} /><b>マイボーダー検証</b><span class="k-pro">Pro</span></figcaption>
        <p class="k-border">マイボーダー：<b>+2,000円</b><br>表示条件：等価・50枚貸し</p>
        <div class="k-cols">
          <div class="k-col"><span class="k-label">開始Gの期待値が基準以上</span><span class="k-count">5実戦</span><span class="k-label">実際の合計収支</span><span class="k-total pos">+29,600円</span><span class="k-avg pos">1実戦平均 +5,920円</span></div>
          <div class="k-col"><span class="k-label">開始Gの期待値が基準未満</span><span class="k-count">7実戦</span><span class="k-label">実際の合計収支</span><span class="k-total neg">-17,000円</span><span class="k-avg neg">1実戦平均 -2,429円</span></div>
        </div>
        <p class="k-note">画面・条件・数値は説明用のサンプルです。</p>
      </figure></div></section>

    <section class="section plans" id="plans"><div class="section-heading"><p class="eyebrow"><b>04</b> SIMPLE PLANS</p><h2>記録と基本の集計は、無料。<br>自分のデータを、もっと使うならPro。</h2><p>どちらも広告なし。日々の記録から始められます。</p></div><div class="billing" role="group" aria-label="料金の表示期間"><button data-billing="month" aria-pressed="true">月額</button><button data-billing="year" aria-pressed="false">年額</button></div>
      <div class="plan-grid"><article class="plan"><span class="plan-kicker">毎日の記録と振り返りに</span><h3>スロログ Free</h3><p class="price">¥0 <small>無料</small></p><ul><li>実戦記録・写真・メモ・収支カレンダー</li><li>収支グラフと機種・ホール・タグ・曜日別の集計</li><li>台メモ・小役カウンター・打ち始めタイマー</li><li>対応機種の公表ボーナス確率による設定推測</li><li>収支カレンダー・戦績の画像共有</li><li>CSV入出力・写真込みバックアップ</li></ul><p class="plan-detail">架空のサンプル機種では、見本の期待値表とマイボーダー検証もProなしで試せます。</p><a class="button" href={APP_STORE_URL_JP} target="_blank" rel="noopener">App Storeで入手 <img src={url("editorial/assets/chevron-right.svg")} alt=""></a></article>
      <article class="plan pro"><span class="plan-kicker">自分の基準と実戦を、もっと深く</span><h3>スロログ Pro</h3><p class="price" aria-live="polite"><span id="pro-price">¥480</span> <small id="pro-period">/ 月（税込）</small></p><p class="plan-detail">Freeのすべての機能に加えて</p><ul><li><strong>自分の機種の期待値表</strong><span>取り込んだ表から期待値・狙い目を確認し、マイボーダーを設定。</span></li><li><strong>マイボーダー検証</strong><span>基準以上／未満の実戦を分けて、結果を比較。</span></li><li><strong>期待値と実戦値</strong><span>対象の実戦の期待値と実収支を、累計グラフで比較。</span></li><li><strong>自分の小役確率で設定推測</strong><span>対応する専用カウンターに、自分で用意した設定別の確率を追加。</span></li><li><strong>共有画像のロゴを非表示</strong><span>カレンダー・戦績の共有画像から、ロゴを外す。</span></li></ul><a class="button primary" href={APP_STORE_URL_JP} target="_blank" rel="noopener">App Storeで入手 <img src={url("editorial/assets/chevron-right.svg")} alt=""></a></article></div>
      <p class="image-note">Proは自動更新サブスクリプションです。アプリ内でプランをご確認ください。価格・無料体験の有無・対象条件は、App Storeの購入確認画面の表示が優先されます。実在機種の期待値表やメーカー非公表の小役確率は、ご自身で用意して取り込む方式です。</p>
    </section>


    <section class="section start-guide" id="start"><div class="section-heading"><p class="eyebrow">GET STARTED</p><h2>まずは、一日分から。</h2></div><div class="start-grid"><article><span>01</span><h3>よく打つ機種を登録</h3><p>機種情報から取り込むか、自分で追加。よく行くホールも登録しておくと、次の入力がスムーズです。</p></article><article><span>02</span><h3>打ったら「＋記録」</h3><p>機種とホール、投資と回収を入力。写真や気づきは、必要なときだけ添えられます。</p></article><article><span>03</span><h3>カレンダーとグラフで振り返る</h3><p>一日、ひと月、一年。記録が増えるほど、自分の実戦の流れを見返せます。</p></article></div><p class="sample-tip">操作を試すなら、マイページの「サンプルを入れる」へ。架空の機種・店舗・実戦データで、記録や期待値表の使い方を無料で確認できます。</p></section>

    <section class="section faq" id="faq"><div><p class="eyebrow"><b>05</b> QUESTIONS &amp; ANSWERS</p><h2>よくある質問</h2><a class="text-link" href={url("support/")}>サポートを見る <img src={url("editorial/assets/external-link.svg")} alt=""></a></div><div class="faq-list">
      <details><summary>無料で、どこまで使えますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>実戦記録、収支グラフ、基本の集計、台メモ、小役カウンター、画像共有、バックアップまで無料です。対応する専用カウンターでは、メーカー公表のボーナス確率を使った設定推測も無料。自分の期待値表を使った計算・比較、自分で入力した小役確率を使った設定推測、共有画像のロゴ非表示はProの機能です。広告はありません。</p></details>
      <details><summary>期待値表は、アプリに入っていますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>実在機種の期待値表は入っていません。ご自身が信頼する表を、貼り付けやファイルから取り込んで使います。出典と利用条件を確認してご利用ください。架空のサンプル機種には見本の表があり、その表での計算とマイボーダー検証をProなしで試せます。</p></details>
      <details><summary>交換率・貸メダルの換算は、どの表でもできますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>換算には、50枚貸し（20円/枚）の現金投資を前提として、交換率が異なる列を2つ以上含む表が必要です。46枚貸しなどの条件は、取り込んだ後に貸メダルの設定で切り替えます。46枚貸しがすでに織り込まれた表を、そのまま取り込まないでください。1列だけの表は、その列の条件のまま使います。</p><p>「再プレイ」「500枚制限」など条件の異なる列も、現金投資の列としては使えません。取り込み時に対象外の列が除かれることがあるため、確認画面で内容を確かめてください。</p><p>表の範囲内で、掲載されていないゲーム数は、隣り合う点を直線でつないだ推定値です。ゾーンなどの変化を正確に再現するものではないため、元の表と条件もあわせて確認してください。</p></details>
      <details><summary>再プレイの切り替えは、どこまで対応していますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>期待値表の「再プレイ」は、投資するメダルの単価を交換単価と同じにする計算です。必要なメダルをすべて再プレイできる前提に相当し、500枚などの上限や、途中から現金投資へ切り替える計算には対応していません。交換率・貸メダルを換算できる表で使います。</p><p>また、この切り替えが店舗付きの過去の実戦に自動適用されるわけではありません。「期待値と実戦値」では、その実戦で選んだ店舗レートが優先されます。</p></details>
      <details><summary>「マイボーダー検証」と「期待値と実戦値」は、同じ計算ですか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>比べ方と計算条件が異なります。マイボーダー検証は、機種ページで現在選んでいる交換率・貸メダルとマイボーダーを使い、開始Gで計算した期待値が基準以上か未満かで実戦を分けます。</p><p>「期待値と実戦値」は、対象となる各実戦の開始Gから計算した期待値と、実際の収支を累計で比べます。店舗がある実戦は記録に対応する店舗レートが優先され、低貸しなど条件の合わない実戦は対象外になります。</p><p>どちらも打った当時の期待値を固定保存したものではなく、現在の表と条件で計算します。表や設定を変更すると、過去の実戦の比較結果も変わることがあります。</p></details>
      <details><summary>小役カウンターで、設定は分かりますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>対応機種の専用カウンターでは、カウントしたデータと設定別の確率を使って、設定ごとの推測割合を表示します。メーカー公表のボーナス確率による推測は無料。Proでは、自分で用意した小役確率を追加できます。</p><p>実際の設定を特定・保証する機能ではありません。短い実戦では結果が大きく偏ることがあり、入力する確率やカウントの条件にも左右されます。一般のカスタムカウンターすべてに設定推測が付くわけではありません。</p></details>
      <details><summary>複数機種をまとめて記録すると、どう集計されますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>台ごとの投資・回収が分からないときに、打った機種の一覧と合計収支を残せます。全体の収支には含まれますが、機種ごとに収支を割り振ることはしません。そのため、機種別の成績や機種ごとの期待値比較には含まれません。</p></details>
      <details><summary>記録や写真は、どこに保存されますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>入力した実戦記録・写真・メモは端末内に保存され、運営のサーバーへ自動送信されません。購入管理にはRevenueCatを利用し、公開機種情報の取得時にも通信します。端末間の自動同期はありません。</p><p>共有画像やバックアップを書き出すときは、ご自身で選んだ相手・アプリ・保存先へ渡されます。詳しくはプライバシーポリシーをご確認ください。</p></details>
      <details><summary>機種変更や、他の収支アプリからの乗り換えはできますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>スロログの記録をまとめて移すときは、写真込みのZIPバックアップを使います。他のアプリからは、対応する項目を割り当ててCSVを取り込めます。取り込み前の確認画面で、日付・金額・機種などをご確認ください。</p><p>CSVは完全なバックアップではありません。写真・期待値表・自分の小役確率・店舗レートの数値設定などは含まれず、回したゲーム数や小役カウントの詳細も引き継げません。大切な記録の保管にはZIPをおすすめします。</p></details>
      <details><summary>Proをやめると、記録は消えますか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>実戦記録や、取り込んだ期待値表・小役確率は消えません。記録と基本の集計、バックアップは引き続き使えます。利用できなくなるのはProの計算・比較、自分の小役確率を使った設定推測、共有画像のロゴ非表示です。メーカー公表値での設定推測は引き続き使えます。</p></details>
      <details><summary>Proの解約・購入の復元はどうすればいいですか？<img src={url("editorial/assets/plus.svg")} alt=""></summary><p>解約はiPhoneの「設定」→ お名前 →「サブスクリプション」から行います。アプリを削除しても解約されません。無料体験の課金を希望しない場合は、終了の24時間以上前に解約してください。無料体験の有無や期間は、購入確認画面でご確認ください。</p><p>機種変更などで購入状況を確認し直すときは、購入に使ったApple Accountで、スロログの「購入を復元」をお試しください。購入の復元と実戦データの復元は別の操作です。</p></details>
    </div></section>

