---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { icons, inlineIcon } from '../lib/icons';
import { url } from '../lib/url';
const published = await getCollection('machines', ({data}) => !data.draft);
// 一覧は導入日の降順。サイトの更新履歴は下の「最近の更新」が受け持つ
const machines = [...published].sort((a,b)=>(b.data.released ?? '').localeCompare(a.data.released ?? '')).slice(0,4);
const fmtDate = (v) => { const [y,m,d] = v.split('-'); return d ? `${y}.${m}.${d}` : `${y}.${m}`; };
const recent = published
  .map((m) => ({ m, at: m.data.updated || m.data.added, note: m.data.updated ? (m.data.updateNote || '内容を更新') : '新規追加' }))
  .filter((r) => r.at)
  .sort((a,b) => b.at.localeCompare(a.at) || a.m.data.name.localeCompare(b.m.data.name))
  .slice(0, 5);
const tools = [
  {icon:'notebookPen', title:'台メモ', text:'当日・前日・前々日のG数を合算。据え置きを考える材料を残す。'},
  {icon:'cherry', title:'小役カウンタ', text:'名前も役も、自分仕様に。数えた回数と確率を実戦メモへ。'},
  {icon:'timer', title:'打ち始めタイマー', text:'打つ前にワンタップ。稼働時間を残して、実戦時給までわかる。'},
  {icon:'history', title:'写真込みバックアップ', text:'写真を含めてZIPで保存。CSVの取込・書き出しも無料。'},
];
const faqs = [
  ['無料でどこまで使えますか？','実戦記録、収支・カレンダー・グラフ、機種・店舗・タグ・曜日別の分析、台メモ、小役カウンタ、バックアップまで無料です。期待値メモも1機種で使えます。広告はありません。'],
  ['期待値表はアプリに付いていますか？','実在機種の期待値表は同梱していません。ご自身が信頼する表を貼り付けるか、ファイルから取り込んで使います。回胴キナナの架空機種によるサンプルも用意しています。計算結果は収支を保証するものではありません。'],
  ['収支や写真はどこに保存されますか？','入力した記録・写真・メモは端末内に保存します。運営者のサーバーには送信しません。課金管理にはRevenueCatを利用し、公開機種情報の取得時にも通信します。詳しくはプライバシーポリシーをご確認ください。'],
  ['機種変更や、他のアプリからの乗り換えは？','他のアプリの記録はCSVから取り込めます。機種変更には写真込みのZIPバックアップをご利用ください。CSVには写真や期待値メモ、店舗情報などは含まれません。'],
  ['Proの無料体験・解約について教えてください。','無料体験は、App Storeで対象と表示される方のみ利用できます。期間・価格は購入確認画面をご確認ください。無料体験を終了するには期間終了の24時間前までに、iPhoneの「設定」→ お名前 →「サブスクリプション」から解約してください。アプリの削除では解約されません。'],
];
---
<Base title="スロログ｜記録から、判断へ。パチスロ収支・立ち回りアプリ" description="記録も分析も無料、広告なし。期待値メモ・台メモ・小役カウンタ・実戦時給まで。回胴キナナと一緒に、毎日の記録を次の立ち回りへ。">
  <section class="hero" aria-labelledby="hero-title" style={`--hero-rays: url("${url('images/amber-hero.webp')}")`}>
    <div class="hero-copy">
      <p class="eyebrow"><span></span> パチスロ収支・立ち回りアプリ</p>
      <h1 id="hero-title">収支を記録し、<br/><em>期待値で狙う。</em></h1>
      <p class="hero-lead">信頼する期待値表を取り込んで、狙い目G数を計算。<br/>実戦を記録して、収支・勝率・時給を見る。</p>
      <p class="hero-description">台メモ・小役カウンタ・打ち始めタイマーも。<br/>ホールで使う機能が揃っています。</p>
      <div class="hero-actions"><a class="pill" href="#features">スロログでできること <span class="ico" set:html={inlineIcon('chevronDown', 17)} /></a><a class="text-link" href={url('machines/')}>機種情報を見る <span class="ico" set:html={inlineIcon('chevronRight', 15)} /></a></div>
      <div class="hero-facts"><span>記録・分析は無料</span><span>広告なし</span><span>記録は端末内</span></div>
      <p class="release-note">iPhone向け · App Store 公開準備中</p>
    </div>
    <div class="hero-visual">
      <img class="kinana" src={url('images/kinana-hero.webp')} width="1024" height="1536" alt="オレンジの花と黄色いドレスの回胴キナナ" fetchpriority="high" />
      <div class="phone"><img src={url('images/screens/analysis.webp')} width="900" height="1955" alt="スロログの収支ページ。今月の収支、勝率、回収率、時給を表示" fetchpriority="high" /></div>
      <div class="visual-caption"><span>powered by 回胴キナナ</span><b>記録を、次の判断に。</b></div>
    </div>
  </section>
  <div class="intro-strip"><span>RECORD. THINK. REVIEW.</span><p>収支アプリは、勝ったか負けたかしか教えてくれない。</p></div>

  <section class="section" id="features">
    <div class="section-heading"><p class="eyebrow">01 / THE SLOLOG WAY</p><h2>打つ前に計算し、ホールで記録し、<br/><span>帰ってから振り返る。</span></h2></div>
    <div class="feature-stories">
      <article class="feature-story"><div class="story-text"><p class="step">01 <span>打つ前に / THINK</span></p><h3>期待値表を取り込んで、<br/>マイボーダーを出す。</h3><p>信頼する期待値表を取り込んで、「何円の期待値から打つか」＝マイボーダーを決めると、そのラインを超える狙い目G数を逆引き。2つ以上のレート列がある表なら、通う店の換金率や貸メダルに合わせて出し直せます。</p><span class="label">期待値メモ · 1機種無料</span></div><div class="screen-stage"><img src={url('images/screens/expectation.webp')} width="900" height="1955" loading="lazy" alt="期待値メモの画面。G数と換金率に合わせて期待値を表示" /></div></article>
      <article class="feature-story"><div class="story-text"><p class="step">02 <span>ホールで / RECORD</span></p><h3>投資・回収・G数を、<br/>1画面で記録する。</h3><p>投資・回収・打ち始めG・稼働時間をひとまとめ。前回の入力をコピーして、写真や気づきも一緒に記録。</p><span class="label">実戦記録 · 無料</span></div><div class="screen-stage"><img src={url('images/screens/record.webp')} width="900" height="1955" loading="lazy" alt="実戦記録フォーム。投資、回収、打ち始めGを入力" /></div></article>
      <article class="feature-story"><div class="story-text"><p class="step">03 <span>帰ってから / REVIEW</span></p><h3>収支・時給・稼働を、<br/>自動で集計する。</h3><p>1日ごとの収支が線になり、時給と稼働時間も自動で出ます。機種・店舗・タグ・曜日でも分解でき、Proならマイボーダー以上／未満の実戦を比べて判断を検証。</p><span class="label">収支分析は無料 · マイボーダー検証はPro</span></div><div class="screen-stage"><img src={url('images/screens/review.webp')} width="900" height="1955" loading="lazy" alt="累積収支のグラフをなぞって、その日の収支と累積を確認。機種別・タグ別・曜日別の内訳も表示" /></div></article>
    </div>
    <p class="image-note">画面は開発中のアプリです。機種・店舗・実戦記録は架空のサンプルです。</p>
    <div class="tools-grid">{tools.map(item=><article><div class="tool-icon" set:html={icons[item.icon]} /><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>


  <section class="section machine-section"><div class="split-heading"><div><p class="eyebrow">02 / MACHINE GUIDE</p><h2>打つ台だけを、<br/><span>そのまま取り込む。</span></h2></div><a class="pill ghost" href={url('machines/')}>機種情報をすべて見る <span class="ico" set:html={inlineIcon('chevronRight', 16)} /></a></div><div class="machines-grid">{machines.map((m,i)=><a class="machine-link" href={url(`machines/${m.id}/`)}>{m.data.image
        ? <img class="featured-cabinet" src={url(m.data.image.src)} alt={m.data.image.alt} loading="lazy" />
        : <span class="cabinet-slot" aria-hidden="true">画像準備中</span>}<p>{m.data.maker}</p><h3>{m.data.name}</h3><span class="machine-foot"><span class="machine-date">{m.data.released || '導入日未定'}</span><span class="ico" set:html={inlineIcon('chevronRight', 18)} /></span></a>)}</div><p class="image-note">出典URLと取得日つきで掲載。詳細ページから機種データをコピーして、アプリに取り込めます。</p>
    <div class="updates"><p class="updates-head">最近の更新</p><ul>{recent.map((r)=>(<li><time datetime={r.at}>{fmtDate(r.at)}</time><a href={url(`machines/${r.m.id}/`)}>{r.m.data.name}</a><span>{r.note}</span></li>))}</ul></div></section>

  <section class="section verify-section" id="verify"><div class="section-heading"><p class="eyebrow">03 / THE ANSWER</p><h2>マイボーダー以上と未満で、<br/><span>成績を分けて比べる。</span></h2></div>
    <div class="verify-grid">
      <div class="verify-text">
        <p>打ち始めG数を記録した実戦を、マイボーダー以上で打った回とそれ未満で打った回に分け、回数・合計・平均を並べて表示します。</p>
        <p>判定はG数の大小ではなく、その打ち始めGの期待値がマイボーダー以上かどうかで行います。ゾーン型の期待値表でも正しく分かれます。打ち始めG数を記録した回が増えるほど、比較の精度が上がります。</p>
        <span class="label">マイボーダー検証 · Pro</span>
      </div>
      <figure class="kensho-card" aria-label="マイボーダー検証の画面例">
        <figcaption class="k-head"><span class="k-ico" set:html={icons.scale} /><b>マイボーダー検証</b><span class="k-pro">Pro</span></figcaption>
        <p class="k-border">あなたの狙い目：<b>509G〜</b>（等価）</p>
        <div class="k-cols">
          <div class="k-col"><span class="k-label">狙い目以上で打った日</span><span class="k-count">5回</span><span class="k-total pos">+29,600円</span><span class="k-avg pos">平均 +5,920円</span></div>
          <div class="k-col"><span class="k-label">狙い目未満で打った日</span><span class="k-count">7回</span><span class="k-total neg">-17,000円</span><span class="k-avg neg">平均 -2,428円</span></div>
        </div>
      </figure>
    </div>
    <p class="image-note">画面は開発中のアプリです。数値は架空のサンプルです。</p>
  </section>

  <section class="section" id="plans"><div class="section-heading"><p class="eyebrow">04 / FREE & PRO</p><h2>記録も、分析も、無料。<br/><span>もっと確かめたい人に、Pro。</span></h2></div><div class="plans-grid">
    <article class="plan"><span class="plan-tag">いつもの記録に</span><h3>スロログ</h3><p class="price">¥0<small>ずっと無料</small></p><ul><li>実戦記録・収支・カレンダー・グラフ</li><li>機種・店舗・タグ・曜日別の分析</li><li>台メモ・小役カウンタ・タイマー</li><li>CSV／写真込みZIP・アプリロック</li><li>期待値メモ 1機種</li></ul><p class="plan-foot">記録件数の制限なし。広告もありません。</p></article>
    <article class="plan pro"><span class="plan-tag">判断を、もう一歩深く</span><h3>スロログ<span>Pro</span></h3><p class="price">¥480<small>／月（税込）</small></p><p class="annual">または ¥3,800／年（税込）</p><ul><li>無料版のすべての機能</li><li>期待値メモを機種数無制限で登録</li><li>マイボーダー以上／未満の実戦を比較</li><li>「マイボーダー検証」で判断を確かめる</li></ul><p class="plan-foot">自動更新サブスクリプション</p></article>
  </div><p class="plan-note">換金率・貸メダルの計算は、2つ以上のレート列を含む表なら無料の1機種でも利用できます。価格と無料体験の対象・期間はApp Storeの購入確認画面を優先します。解約方法は<a href={url('terms/')}>利用規約</a>をご確認ください。</p><div class="data-strip"><p><b>書き出しは無料。制限もかけません。</b>実戦記録・機種・店舗をCSVで、写真を含めた全データをZIPで書き出せます。Proを解約しても記録は端末に残り、書き出しもそのまま使えます。</p></div></section>

  <section class="section faq-section" id="faq"><div><p class="eyebrow">05 / FAQ</p><h2>よくある質問</h2><a class="text-link" href={url('support/')}>サポートはこちら <span class="ico" set:html={inlineIcon('chevronRight', 15)} /></a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></section>

  <section class="download" id="download"><img class="app-icon" src={url('images/app-icon.webp')} width="80" height="80" alt="スロログのアプリアイコン" loading="lazy" /><p class="eyebrow">SLOLOG · powered by 回胴キナナ</p><h2>記録から、<span>判断へ。</span></h2><p>毎日の実戦に、自分だけの根拠を。</p><img class="store-badge" src={url('images/badge-appstore.svg')} width="136" height="50" alt="App Store でダウンロード" loading="lazy" /><p class="download-note">iPhone向けアプリ。公開後、このバッジからダウンロードできます。</p></section>
</Base>
<style>
  :global(main#main-content){padding:0 0 90px}
  .hero{display:grid;grid-template-columns:1fr 1fr;min-height:750px;position:relative;isolation:isolate;gap:12px;align-items:center}
  .hero:before{content:'';position:absolute;inset:0 calc((min(1220px,100vw - 80px) - 100vw)/2);z-index:-2;background:linear-gradient(90deg,#0c0d10 2%,#0c0d10bb 36%,transparent 72%),var(--hero-rays) center/cover no-repeat;opacity:.7}
  .hero:after{content:'';position:absolute;inset:0 -5%;z-index:-1;background:linear-gradient(180deg,#0c0d10,transparent 12%,transparent 75%,#0c0d10);pointer-events:none}
  .hero-copy{position:relative;z-index:4;padding:70px 0 80px}.eyebrow{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:800;letter-spacing:.13em;color:var(--orange);margin:0 0 24px}.eyebrow>span{width:7px;height:7px;border-radius:50%;background:var(--orange)}
  h1{font-size:clamp(44px,5.6vw,80px);font-weight:900;letter-spacing:-.07em;line-height:1.25;margin:0}h1 em{font-style:normal;color:var(--orange-light)}.hero-lead{font-size:22px;line-height:1.85;font-weight:700;margin:30px 0 17px}.hero-description{color:#bfc2ca;font-size:16px;line-height:1.9}.hero-actions{display:flex;align-items:center;gap:23px;flex-wrap:wrap;margin:34px 0 26px}.hero-actions .pill{min-height:54px}.pill span{margin-left:15px}.text-link{font-size:14px;color:var(--text);font-weight:700;border-bottom:1px solid #555960;padding-bottom:5px;transition:color .2s}.text-link:hover{color:var(--orange-light)}.hero-facts{display:flex;gap:13px;flex-wrap:wrap;font-size:13px}.hero-facts span+span{border-left:1px solid #555960;padding-left:13px}.release-note{font-size:13px;color:var(--sub);margin-top:14px}
  .hero-visual{height:710px;position:relative;isolation:isolate;overflow:clip}.kinana{position:absolute;width:78%;height:auto;right:0;bottom:-15px;z-index:1;filter:drop-shadow(0 22px 35px #0007)}.phone{position:absolute;left:7%;top:124px;width:45%;padding:7px;border:1px solid #676c75;border-radius:36px;background:#17191d;transform:rotate(-7deg);z-index:2;box-shadow:0 26px 75px #000b,inset 0 0 0 2px #ffffff10}.phone img{display:block;width:100%;height:auto;border-radius:28px}.visual-caption{position:absolute;bottom:24px;right:0;padding:14px 20px;border:1px solid #b98134;border-radius:10px;z-index:3;background:#10100fea;backdrop-filter:blur(12px);box-shadow:0 10px 35px #0006}.visual-caption span{display:block;font-size:12px;color:var(--orange-light);letter-spacing:.04em}.visual-caption b{font-size:16px;font-weight:700}
  .intro-strip{position:relative;display:flex;align-items:center;justify-content:space-between;gap:20px;border-block:1px solid var(--line);padding:24px 0}.intro-strip>span{font-size:12px;font-weight:700;letter-spacing:.14em;color:var(--orange)}.intro-strip p{font-size:20px;font-weight:700;margin:0}.intro-strip .strip-arrow{font-size:32px}.section{padding-top:110px}.section-heading{margin-bottom:42px}h2{font-size:clamp(30px,3.7vw,46px);margin:0;letter-spacing:-.045em;line-height:1.45}h2 span{color:var(--sub)}
  .feature-stories{display:grid;grid-template-columns:1fr 1fr;gap:22px}.feature-story{display:grid;grid-template-columns:1fr 1fr;background:var(--bg-soft);border:1px solid var(--line);border-radius:20px;overflow:hidden;min-width:0}.feature-story:first-child{grid-column:1/-1;grid-template-columns:1fr 1fr;min-height:485px;background:linear-gradient(125deg,#27221b,#141517 62%);border-color:#615036}.story-text{position:relative;z-index:2;padding:30px 24px}.step{font-size:30px;font-weight:800;color:var(--orange);margin:0 0 22px}.step span{display:block;color:var(--sub);font-size:12px;font-weight:600;letter-spacing:.06em;margin-top:6px}.story-text h3{font-size:25px;line-height:1.5;letter-spacing:-.04em;margin:0;text-wrap:balance}.story-text>p:not(.step){font-size:16px;color:var(--sub);line-height:1.95;margin:18px 0 20px}.label{display:inline-block;font-size:12px;color:var(--orange-light);line-height:1.8}.screen-stage{height:430px;overflow:hidden;padding:40px 18px 0;background:radial-gradient(ellipse at bottom,#f5972a16,transparent 70%);align-self:end;position:relative}.screen-stage img{display:block;width:100%;height:auto;border:1px solid #454950;border-radius:24px 24px 0 0;box-shadow:0 10px 30px #0005}.feature-story:first-child .story-text{padding:48px 52px}.feature-story:first-child .step{display:flex;align-items:center;gap:16px;font-size:36px;margin-bottom:24px}.feature-story:first-child .step span{display:inline;margin:0}.feature-story:first-child h3{font-size:37px}.feature-story:first-child .story-text>p:not(.step){max-width:420px}.feature-story:first-child .screen-stage{height:480px;padding:35px 65px 0}.feature-story:first-child .screen-stage img{width:min(100%,300px);margin:auto;transform:rotate(5deg);border-radius:30px 30px 0 0;box-shadow:0 15px 50px #000a}.image-note{font-size:13px;color:var(--sub);margin:20px 0 0;line-height:1.8}.updates{margin-top:34px;padding-top:26px;border-top:1px solid var(--line)}.updates-head{margin:0 0 14px;font-size:12px;font-weight:700