---
import Editorial from '../layouts/Editorial.astro';
import Icon from '../components/editorial/Icon.astro';
import { SUPPORT_EMAIL } from '../lib/legal';
import { url } from '../lib/url';
const sections = [
  { id: 'contact', title: 'お問い合わせ', body: null },
  { id: 'lost', title: '記録が消えてしまった', body: 'アプリは起動時、1日1回端末内へ自動バックアップを取っています（直近3世代・写真本体は含みません）。マイページ →「自動バックアップから復元」を開くと、日時と件数を見ながら戻す世代を選べます。手動で書き出したバックアップZIPがあれば、そちらからも復元できます。' },
  { id: 'migrate', title: '機種変更するときは', body: 'マイページ →「バックアップ」で写真込みのZIPを書き出し、新しい端末で読み込んでください。CSVは文字だけのファイルなので、写真・期待値メモ・店舗は含まれません。丸ごと移すときは必ずZIPを使ってください。' },
  { id: 'cancel', title: 'スロログProを解約したい', body: 'iPhoneの「設定」→ お名前 →「サブスクリプション」→ スロログ から解約できます。無料トライアル中に解約すれば料金はかかりません（期間終了の24時間前までに手続きが必要です）。機種変更したときは、マイページの「購入を復元」で引き継げます。' },
  { id: 'ev', title: '期待値のデータは配っていますか', body: '配っていません。スロログは中立の計算機に徹していて、期待値の表はご自身で用意したものを取り込む形です。アプリから解析値や攻略情報を提供することはありません。' },
];
---
<Editorial title="サポート｜スロログ" description="スロログのお問い合わせ・よくある質問。">
  <div class="page-wrap legal-wrap">
    <nav class="breadcrumbs" aria-label="パンくず"><a href={url('')}>スロログ</a><span>/</span><span aria-current="page">サポート</span></nav>
    <div class="page-title"><p class="eyebrow">SUPPORT</p><h1>サポート</h1><p>不具合・ご要望・データの引っ越しについて。</p></div>
    <div class="document-grid">
      <aside class="document-toc"><details open><summary>このページの内容 <Icon name="plus" /></summary><nav aria-label="目次">{sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav></details><div class="document-links"><a href={url('privacy/')}>プライバシーポリシー</a><a href={url('terms/')}>利用規約</a><a href={`mailto:${SUPPORT_EMAIL}`}>メールで問い合わせ <Icon name="arrow-up-right" /></a></div></aside>
      <article class="legal-text">
        <h2 id="contact">お問い合わせ</h2>
        <p>不具合の報告・ご要望は <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> までお送りください。端末の機種とiOSのバージョン、どの画面で何をしたときに起きたかを書いていただけると、原因を特定しやすくなります。</p>
        {sections.filter(s=>s.body).map(s=><><h2 id={s.id}>{s.title}</h2><p>{s.body}</p></>)}
        <div class="document-end"><span>スロログ / Re:Spect</span><a href={url('')}>トップに戻る <Icon /></a></div>
      </article>
    </div>
  </div>
</Editorial>
