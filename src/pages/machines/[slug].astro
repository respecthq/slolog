---
import {getCollection, render} from 'astro:content';
import Editorial from '../../layouts/Editorial.astro';
import Icon from '../../components/editorial/Icon.astro';
import SpecRows from '../../components/editorial/SpecRows.astro';
import {toSpec} from '../../lib/spec';
import {url} from '../../lib/url';
export async function getStaticPaths() {
  return (await getCollection('machines',({data})=>!data.draft)).map(m=>({params:{slug:m.id},props:{m}}));
}
const {m}=Astro.props;
const d=m.data;
const {Content,headings}=await render(m);
const toc=headings.filter(h=>h.depth===2);
const specJson=JSON.stringify(toSpec(m),null,2);
const fmt=(value?:string)=>value?.replaceAll('-','.')||'未定';
const specs=[['純増',d.junzo],['ボーナス',d.bonusPayout],['ボーナス合成確率',d.bonus],['出玉率',d.payout]];
// 出典は①メーカー公式 ②スペックのページ（別にあるとき）③業界紙 の順に並べる
const paper=(u:string)=>/yugitsushin/.test(u)?'遊技通信':/greenbelt/.test(u)?'グリーンべると':/amusement-japan|yugi-nippon/.test(u)?'遊技日本':/prtimes/.test(u)?'PR TIMES':'業界紙';
const sources=[[d.source,'メーカー公式'],[d.specSource,'スペック（メーカー公式）'],[d.newsSource,d.newsSource?`業界紙「${paper(d.newsSource)}」`:'']].filter(([u])=>u) as [string,string][];
const circled='①②③④';
const ceiling=[['天井',d.ceiling],['天井恩恵',d.ceilingBonus],['ゾーン',d.zone],['設定変更時',d.resetBehavior]];
import {DEEPLINK_ENABLED, deepLinkFor, APP_STORE_URL_JP} from '../../lib/store';
---
<Editorial title={`${d.name}｜新台・機種情報｜スロログ`} description={`${d.name}の基本情報と出典。機種データをスロログへ取り込めます。`} socialImage={null}>
  <div class="page-wrap">
    <nav class="breadcrumbs" aria-label="パンくず"><a href={url('')}>スロログ</a><span>/</span><a href={url('machines/')}>機種情報</a><span>/</span><span aria-current="page">{d.name}</span></nav>
    <div class:list={['detail-heading',{'has-image':!!d.image}]}>
      <div><p class="eyebrow">MACHINE GUIDE / {d.maker}</p><h1>{d.name}</h1><div class="detail-meta"><span>{d.fictional?'架空機 / サンプル':`${fmt(d.released)} 導入`}</span>{d.type&&<span>{d.type}</span>}</div>{d.fictional?<p>Re:Spectのオリジナル機です。実在するホールには設置されていません。掲載値は自社シミュレーターの実装・実測に基づきます。</p>:d.added&&<p class="detail-dates">掲載 <time datetime={d.added}>{fmt(d.added)}</time>{d.updated&&d.updated>d.added&&<> ／ 更新 <time datetime={d.updated}>{fmt(d.updated)}</time></>}</p>}</div>
      {d.image&&<figure><img src={url(d.image.src)} alt={d.image.alt} width="230" height="380" /><figcaption>{d.image.credit}</figcaption></figure>}
    </div>
    <div class="detail-layout">
      <div class="detail-main">
        <section class="spec-section"><div class="section-label"><span>01 / BASIC INFORMATION</span><h2>基本情報</h2></div>
          <SpecRows items={[['メーカー',d.maker],['導入時期',d.fictional?'架空機のため実機導入なし':fmt(d.released)],['型式名',d.modelName],['タイプ',d.type],['分類',d.gen]]} />
          <h3>基本スペック</h3>{specs.some(([,v])=>v)?<>{<SpecRows items={specs}/>}{d.specNote&&<p class="muted spec-note">{d.specNote}</p>}</>:<p class="muted">公表値の記載はありません。</p>}
          <div class="source-note">{d.fictional?'出典：Re:Spect（自社シミュレーター）':<>{sources.map(([u,label],i)=><span class="source-link">出典{sources.length>1?circled[i]:''}：<a href={u} target="_blank" rel="noopener noreferrer">{label} <Icon name="external-link" /></a></span>)}{d.fetched&&<span>取得日：{fmt(d.fetched)}</span>}</>}</div>
        </section>
        {d.fictional&&<section class="spec-section"><div class="section-label"><span>02 / OWN SIMULATOR</span><h2>天井・ゾーン</h2></div>
          {ceiling.some(([,v])=>v)?<SpecRows items={ceiling}/>:<p class="muted">掲載していません。</p>}
        </section>}
        {toc.length>1&&<nav class="article-toc" aria-label="スペック詳細の目次"><span>このページの内容</span>{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
        <div class="machine-prose"><Content /></div>
        {!d.fictional&&<details class="spec-json"><summary>取り込まれるデータを確認 <Icon name="plus" /></summary><pre tabindex="0">{specJson}</pre></details>}
      </div>
      {d.fictional?<aside class="import-panel"><p class="eyebrow">SAMPLE MACHINE</p><h2>自分の記録を変えずに、<br />スロログを試す。</h2><p>実在しないオリジナル機です。アプリの「サンプルを入れる」から、架空の機種と実戦データを追加できます。</p><a class="button primary" href={url('#features')}>スロログの機能を見る <Icon /></a></aside>:
      <aside class="import-panel"><p class="eyebrow">ADD TO SLOLOG</p><h2>この機種を、<br />自分のスロログへ。</h2><p>基本情報を取り込んで、狙い目や期待値メモはアプリで追加できます。</p><ol><li>機種データをコピー</li><li>アプリの「機種を取り込む」を開く</li><li>貼り付けて登録</li></ol>{DEEPLINK_ENABLED&&<a class="button primary" id="open-in-app" href={deepLinkFor(m.id)} data-store={APP_STORE_URL_JP}>スロログで開く <Icon name="external-link" /></a>}{DEEPLINK_ENABLED&&<p class="copy-status">アプリが開き、確認のあとに登録されます（iPhone・バージョン 1.0.2 以降）。開かないときは、下の手順で取り込めます。</p>}<button class="button primary" id="copy-spec">機種データをコピー <Icon name="copy" /></button><p id="copy-status" class="copy-status" role="status" aria-live="polite"></p><div id="copy-fallback" hidden><label for="manual-spec">データを選択してコピー</label><textarea id="manual-spec" readonly rows="8">{specJson}</textarea></div><script is:inline id="machine-spec" type="application/json" set:html={specJson.replaceAll('<','\u005cu003c')}></script><a class="text-link" href={url(`machines/${m.id}.json`)}>JSONファイルを直接開く <Icon name="external-link" /></a></aside>}
    </div>
    <div class="back-to-catalog"><a href={url('machines/')} class="button">機種一覧へ戻る <Icon /></a></div>
  </div>
</Editorial>
