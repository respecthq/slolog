---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { inlineIcon } from '../../lib/icons';
import { url } from '../../lib/url';

const machines = (await getCollection('machines', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.released ?? '').localeCompare(a.data.released ?? ''));

const fmt = (iso?: string) => {
  if (!iso) return '導入日未定';
  const [y, m, d] = iso.split('-').map(Number);
  return d ? `${y}年${m}月${d}日` : m ? `${y}年${m}月` : `${y}年`;
};
const shortDate = (iso?: string) => {
  if (!iso) return '導入日未定';
  const [y, m, d] = iso.split('-').map(Number);
  return d
    ? `${y}.${String(m).padStart(2, '0')}.${String(d).padStart(2, '0')}`
    : `${y}.${String(m).padStart(2, '0')} 予定`;
};
type M = (typeof machines)[number];
const groups: { label: string; items: M[] }[] = [];
for (const m of machines) {
  const label = fmt(m.data.released);
  const g = groups.find((item) => item.label === label);
  if (g) g.items.push(m);
  else groups.push({ label, items: [m] });
}
---

<Base title="新台・機種情報｜スロログ" description="導入日の新しい順で見るパチスロ新台・機種情報。メーカー公表事実を確認し、スロログアプリへ取り込めます。">
  <div class="hub">
    <section class="hub-hero">
      <div class="hub-heading"><div><p class="kicker">SLOLOG / MACHINE GUIDE</p><h1>メーカー公表スペックを、<br/><span>アプリに取り込む。</span></h1></div><p class="hub-lead">機種名・メーカー・導入日を、出典と取得日つきで掲載。<br/>詳細ページの「機種データをコピー」から、<br/>スロログにそのまま貼り付けられます。</p></div>
      <div class="hub-toolbar"><div class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input id="machineSearch" type="search" placeholder="機種名・メーカーで検索" aria-label="機種名・メーカーで検索" /></div><span class="hub-count">{machines.length}<small>機種掲載</small></span></div>
    </section>
    <div class="principle"><p><span>01</span> メーカー公式の情報</p><p><span>02</span> 出典・取得日を明記</p><p><span>03</span> アプリへ取り込み</p></div>

    <div class="hub-grid">
      <section class="articles" aria-labelledby="latestTitle">
        <div class="section-title">
          <div><p>LATEST MACHINES</p><h2 id="latestTitle">新着の機種情報</h2></div>
          <span id="resultCount" aria-live="polite" role="status">{machines.length}件</span>
        </div>

        <div class="article-grid" id="machineGrid">
          {machines.map((m, index) => (
            <article class="machine-card" data-search={`${m.data.name} ${m.data.maker}`.toLowerCase()}>
              <a href={url(`machines/${m.id}/`)}>
                <div class="machine-thumbnail">{m.data.image
                  ? <img src={url(m.data.image.src)} alt={m.data.image.alt} loading="lazy" />
                  : <span class="thumb-slot" aria-hidden="true">画像準備中</span>}</div>
                <div class="machine-card-top"><span class="maker">{m.data.maker}</span><span class="card-arrow ico" aria-hidden="true" set:html={inlineIcon('chevronRight', 20)} /></div>
                <div class="machine-body">
                  <p class="date">導入時期 <span>{shortDate(m.data.released)}</span></p>
                  <h3>{m.data.name}</h3>
                  <p class="excerpt">

                    {m.data.ceiling ? `天井 ${m.data.ceiling}。` : ''}
                    {m.data.junzo ? `純増 ${m.data.junzo}。` : ''}
                    {!m.data.ceiling && !m.data.junzo && '公表情報・出典を確認する'}
                  </p>
                  <span class="read">機種情報を見る <span class="ico" aria-hidden="true" set:html={inlineIcon('chevronRight', 17)} /></span>
                </div>
              </a>
            </article>
          ))}
        </div>
        <p class="empty" id="emptyState" hidden>条件に合う機種が見つかりませんでした。</p>
      </section>

      <aside class="release" aria-labelledby="releaseTitle">
        <div class="release-head"><small>BY RELEASE DATE</small><h2 id="releaseTitle">導入日から探す</h2></div>
        <div class="release-list">
          {groups.map((g) => (
            <section>
              <h3>{g.label}<small>{g.label !== '導入日未定' && ' 導入'}</small></h3>
              {g.items.map((m) => <a href={url(`machines/${m.id}/`)}>{m.data.name}<span>›</span></a>)}
            </section>
          ))}
        </div>
      </aside>
    </div>

    <section class="app-cta">
      <div>
        <p>FROM WEB TO APP</p>
        <h2>調べた機種を、<span>自分の立ち回りへ。</span></h2>
        <p class="desc">メーカー公表スペックを取り込み、自分の狙い目・ヤメ時・期待値メモをアプリ内で管理できます。</p>
      </div>
      <a class="pill" href={url('')}>スロログについて <span class="ico" set:html={inlineIcon('chevronRight', 16)} /></a>
    </section>
  </div>

  <script>
    const search = document.getElementById('machineSearch') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.machine-card'));
    const count = document.getElementById('resultCount');
    const empty = document.getElementById('emptyState');
    search?.addEventListener('input', () => {
      const query = search.value.normalize('NFKC').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const show = !query || (card.dataset.search ?? '').normalize('NFKC').includes(query);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = `${visible}件`;
      if (empty) empty.hidden = visible !== 0;
    });
  </script>
</Base>

