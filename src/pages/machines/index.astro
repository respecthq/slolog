---
import Editorial from '../../layouts/Editorial.astro';
import Icon from '../../components/editorial/Icon.astro';
import ReleaseList from '../../components/editorial/ReleaseList.astro';
import {getCollection} from 'astro:content';
import {url} from '../../lib/url';
const machines = (await getCollection('machines',({data})=>!data.draft))
  .sort((a,b)=>(b.data.released??'').localeCompare(a.data.released??'')||a.data.name.localeCompare(b.data.name,'ja'));
const real = machines.filter(m=>!m.data.fictional);
const kinana = machines.find(m=>m.data.fictional);
---
<Editorial title="新台・機種情報｜スロログ" description="機種の基本情報とスペックを出典とともに。調べたデータは、そのままスロログへ。">
  <div class="page-wrap">
    <nav class="breadcrumbs" aria-label="パンくず"><a href={url('')}>スロログ</a><span>/</span><span aria-current="page">機種情報</span></nav>
    <div class="page-title"><p class="eyebrow">MACHINE GUIDE</p><h1>新台・機種情報</h1><p>機種の基本情報とスペックを、出典とともに。<br />調べたデータは、そのままスロログへ。</p></div>
    <div class="catalog-toolbar"><label class="search-input"><span>機種名・メーカー</span><input id="machine-search" type="search" placeholder="機種名・メーカーで検索" autocomplete="off" /></label><p class="result-count" id="result-count" role="status" aria-live="polite"><b>{real.length}</b> 機種</p></div>
    <div class="catalog-layout">
      <section aria-label="機種一覧">
        <div class="catalog-heading"><h2>掲載機種</h2><span>導入時期が新しい順</span></div>
        <div class="catalog-grid">{real.map(m=><article class="catalog-item" data-search={`${m.data.name} ${m.data.maker}`.normalize('NFKC').toLowerCase()}>
          <a href={url(`machines/${m.id}/`)}><div class="catalog-meta"><span>{m.data.maker}</span><time datetime={m.data.released}>{m.data.released?.replaceAll('-','.')||'未定'}</time></div><h2>{m.data.name}</h2><p>{m.data.type||m.data.gen||(m.data.noCeiling?'ノーマル':'公表スペック・基本情報')}</p><div class="catalog-foot"><span>{m.data.noCeiling?'天井なし':m.data.ceiling?'天井情報あり':'基本情報を確認'}</span><Icon name="arrow-up-right" /></div></a>
        </article>)}</div>
        <div id="no-results" class="no-results" hidden><h2>一致する機種がありません</h2><p>機種名やメーカー名を変えて検索してください。</p><button id="clear-search" class="button">検索をクリア</button></div>
      </section>
      <aside class="catalog-aside">
        <ReleaseList machines={machines} />
        {kinana&&<a class="sample-machine" href={url(`machines/${kinana.id}/`)}><p class="eyebrow">SLOLOG ORIGINAL</p>{kinana.data.image&&<img src={url(kinana.data.image.src)} alt={kinana.data.image.alt} width="220" height="360" loading="lazy" />}<span class="sample-badge">架空機 / サンプル</span><h2>回胴キナナ</h2><p>スロログの機能を試せる<br />オリジナルシミュレーター。</p><span class="text-link">スペックを見る <Icon /></span></a>}
        <div class="source-principles"><p class="eyebrow">INFORMATION POLICY</p><h2>情報の出典を、<br />大切にしています。</h2><p>メーカー公表情報と、確認できた天井情報を分けて掲載。未確認の数値や画像は追加していません。</p><a href={url('terms/#section-3')}>掲載情報について <Icon name="arrow-up-right" /></a></div>
      </aside>
    </div>
  </div>
</Editorial>
