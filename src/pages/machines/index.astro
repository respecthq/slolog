---
import Editorial from '../../layouts/Editorial.astro';
import Icon from '../../components/editorial/Icon.astro';
import ReleaseList from '../../components/editorial/ReleaseList.astro';
import {getCollection} from 'astro:content';
import {url} from '../../lib/url';
const machines = (await getCollection('machines',({data})=>!data.draft))
  .sort((a,b)=>(b.data.released??'').localeCompare(a.data.released??'')||a.data.name.localeCompare(b.data.name,'ja'));
const real = machines.filter(m=>!m.data.fictional);
const kinana = machines.find(m=>m.data.fictional);
---
<Editorial title="新台・機種情報｜調べて、スロログに登録" description="パチスロの機種情報と導入時期を、出典とあわせて確認。気になる機種の基本情報をスロログに登録し、自分の記録やメモにつなげられます。">
  <div class="page-wrap">
    <nav class="breadcrumbs" aria-label="パンくず"><a href={url('')}>スロログ</a><span>/</span><span aria-current="page">機種情報</span></nav>
    <div class="page-title"><p class="eyebrow">MACHINE GUIDE</p><h1>新台・機種情報</h1><p>気になる一台を、調べるところから。<br />基本情報を確認して、そのまま自分のスロログへ。</p></div>
    <div class="catalog-toolbar"><label class="search-input"><span>機種名・メーカーで検索</span><input id="machine-search" type="search" placeholder="機種名・メーカーで検索" autocomplete="off" /></label><p class="result-count" id="result-count" role="status" aria-live="polite"><b>{real.length}</b> 機種</p></div>
    <p class="muted catalog-disclaimer">導入時期は掲載情報に基づく目安です。変更される場合があり、地域やホールによっても異なります。各ホールでの設置・導入状況を保証するものではありません。</p>
    <div class="catalog-layout">
      <section aria-label="機種一覧">
        <div class="catalog-heading"><h2>掲載機種</h2><span>導入時期が新しい順</span></div>
        <div class="catalog-grid">{real.map(m=><article class="catalog-item" data-search={`${m.data.name} ${m.data.maker}`.normalize('NFKC').toLowerCase()}>
          <a href={url(`machines/${m.id}/`)}><div class="catalog-meta"><span>{m.data.maker}</span><time datetime={m.data.added} title="このサイトへの掲載日">{m.data.added?.replaceAll('-','.')}</time></div>{m.data.image?<><div class="catalog-mid"><span class="catalog-thumb"><img src={url(m.data.image.src)} alt="" width="84" height="145" loading="lazy" /></span><div><h2>{m.data.name}</h2><p>{m.data.type||m.data.gen||'基本情報・出典'}</p></div></div>{m.data.image?.credit&&<small class="catalog-rights">{m.data.image.credit}</small>}</>:<><h2>{m.data.name}</h2><p>{m.data.type||m.data.gen||'基本情報・出典'}</p></>}<div class="catalog-foot"><span class="catalog-ceiling">{m.data.released?`導入時期：${m.data.released.replaceAll('-','.')}`:'導入時期未定'}</span><Icon /></div></a>
        </article>)}</div>
        <nav id="pager" class="pager" aria-label="ページ" hidden></nav>
        <div id="no-results" class="no-results" hidden><h2>条件に合う機種が見つかりませんでした</h2><p>機種名の一部や、メーカー名でお試しください。</p><button id="clear-search" class="button">検索をクリア</button></div>
      </section>
      <aside class="catalog-aside">
        <ReleaseList machines={machines} />
        {kinana&&<a class="sample-machine" href={url(`machines/${kinana.id}/`)}><p class="eyebrow">SLOLOG ORIGINAL</p>{kinana.data.image&&<img src={url(kinana.data.image.src)} alt={kinana.data.image.alt} width="220" height="360" loading="lazy" />}<span class="sample-badge">架空機 / サンプル</span><h2>回胴キナナ</h2><p>架空の機種と実戦データで、<br />スロログの使い方を確認できます。</p><span class="text-link">サンプル機種を見る <Icon /></span></a>}
      </aside>
    </div>
  </div>
</Editorial>
<style>.catalog-disclaimer{font-size:12px;line-height:1.8;margin:0 0 24px}</style>
