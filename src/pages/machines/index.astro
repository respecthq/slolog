der-radius:14px;overflow:hidden;transition:transform .2s,border-color .2s}.machine-card:hover{transform:translateY(-3px);border-color:#b27632}.machine-card a{display:block;color:var(--text);height:100%;padding:24px}.machine-card-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.maker{font-size:13px;color:var(--sub);padding:4px 9px;background:#22252c;border-radius:4px}.card-arrow{color:var(--orange)}.machine-body{display:flex;flex-direction:column}.date{order:2;margin:24px 0 0;display:flex;justify-content:space-between;gap:16px;font-size:13px;color:var(--sub);padding-top:15px;border-top:1px solid var(--line)}.date span{font-variant-numeric:tabular-nums;color:var(--text)}.machine-body h3{font-size:23px;line-height:1.6;min-height:75px;letter-spacing:-.03em;margin:24px 0 8px}.excerpt{font-size:14px;color:var(--sub);line-height:1.8;min-height:28px;margin:0}.read{order:3;display:flex;justify-content:space-between;color:var(--orange);font-size:14px;font-weight:700;margin-top:18px}.read span{font-size:18px}.empty{padding:50px 24px;text-align:center;border:1px dashed var(--line);border-radius:14px;color:var(--sub)}.release{position:sticky;top:110px;border-left:1px solid var(--line);padding-left:25px}.release-head small{font-size:12px;color:var(--orange);letter-spacing:.12em;font-weight:700}.release-head h2{font-size:22px;margin:7px 0 24px}.release-list{max-height:680px;overflow:auto;padding-right:8px;scrollbar-width:thin;scrollbar-color:#4e525c transparent}.release-list section{margin-bottom:22px}.release-list h3{font-size:14px;margin:0 0 8px;color:var(--text);padding-left:12px;border-left:2px solid var(--orange)}.release-list h3 small{font-weight:400;color:var(--sub);font-size:12px}.release-list a{display:flex;justify-content:space-between;gap:12px;font-size:14px;color:var(--sub);padding:9px 0;border-bottom:1px solid #22252c}.release-list a:hover{color:var(--orange-light)}.release-list a span{color:var(--orange)}.app-cta{display:flex;justify-conten