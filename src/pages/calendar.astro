---
// 新台カレンダー。デザインは Astra の mockups/calendar-v1。データはビルド時に機種ファイルから作って埋め込む
// X の固定ポストから月へ直接飛べるよう、#mYYYY-MM のリンクで月を開く
import Editorial from '../layouts/Editorial.astro';
import {getCollection} from 'astro:content';
import {url} from '../lib/url';
import {APP_STORE_URL_JP} from '../lib/store';

const machines = (await getCollection('machines', ({data}) => !data.draft && !data.fictional))
  .filter((m) => /^\d{4}-\d{2}(?:-\d{2})?$/.test(m.data.released ?? ''))
  .map((m) => ({id: m.id, name: m.data.name, maker: m.data.maker || '', released: m.data.released, gen: m.data.gen || '',
    machineType: m.data.type || '', payout: m.data.payout || '', specNote: m.data.payout ? (m.data.specNote || '') : ''}))
  .sort((a, b) => a.released.localeCompare(b.released) || a.name.localeCompare(b.name, 'ja'));
const boot = `window.CALENDAR_DATA=${JSON.stringify(machines).replace(/</g, '\\u003c')};window.CALENDAR_BASE=${JSON.stringify(url(''))};`;
---
<Editorial title="新台カレンダー｜パチスロの導入時期をチェック｜スロログ" description="掲載機種の導入時期を、月ごとのカレンダーと一覧で確認。機種名・メーカーで検索し、詳細ページでスペックや出典も確認できます。">
  <link rel="stylesheet" href={url('editorial/calendar.css')} />
  <div class="cal2">
    <nav class="cal-crumbs" aria-label="パンくず"><a href={url('')}>スロログ</a><span>/</span><a href={url('machines/')}>機種情報</a><span>/</span><span aria-current="page">新台カレンダー</span></nav>

    <section class="cal-hero" aria-labelledby="cal-title">
      <p class="cal-kicker">気になる新台の導入月をチェック</p>
      <h1 id="cal-title">新台<em>カレンダー</em></h1>
      <p class="cal-lead">掲載している機種を、月ごとにまとめています。<br />機種名やメーカーから、全部の月をまとめて探せます。</p>
      <div class="search-bar">
        <div class="search-field"><img src={url("editorial/calendar/search.svg")} alt=""><input type="search" id="search" placeholder="機種名・メーカーで検索" aria-label="全導入月の機種名・メーカーを検索"><button id="clear-search" class="icon-button" type="button" aria-label="検索をクリア" title="検索をクリア" hidden><img src={url("editorial/calendar/x.svg")} alt=""></button></div>
        <label class="maker-filter"><img src={url("editorial/calendar/sliders-horizontal.svg")} alt=""><select id="maker" aria-label="メーカーで絞り込む"><option value="">すべてのメーカー</option></select></label>
      </div>
    </section>

    <section class="month-band" aria-label="導入月">
      <div class="band-inner">
        <div class="month-title">
          <p id="month-year">2027</p>
          <h2><span id="month-number">01</span><span class="month-unit">月</span></h2>
          <span id="month-english">JANUARY</span>
        </div>
        <div class="band-row">
          <div class="band-nav">
            <nav id="month-nav" aria-label="導入予定月"></nav>
            <details id="archive" hidden><summary>過去の導入月</summary><nav id="archive-nav" aria-label="過去の導入月"></nav></details>
          </div>
          <div class="month-actions">
            <button type="button" class="today-button" id="today">今月に戻る</button>
            <div class="month-arrows">
              <button type="button" id="prev" class="icon-button" aria-label="前の月" title="前の月"><img src={url("editorial/calendar/chevron-left.svg")} alt=""></button>
              <button type="button" id="next" class="icon-button" aria-label="次の月" title="次の月"><img src={url("editorial/calendar/chevron-right.svg")} alt=""></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="cal-body">
      <div class="view-toolbar">
        <p class="result-summary" id="result-label" role="status" aria-live="polite"></p>
        <div class="segmented" role="group" aria-label="表示形式">
          <button type="button" data-view="calendar" aria-pressed="true"><img src={url("editorial/calendar/calendar-days.svg")} alt=""><span>カレンダー</span></button>
          <button type="button" data-view="list" aria-pressed="false"><img src={url("editorial/calendar/list.svg")} alt=""><span>リスト</span></button>
        </div>
      </div>
      <div id="calendar-wrap">
        <div class="calendar-card">
          <div class="weekdays" aria-hidden="true"><span>月</span><span>火</span><span>水</span><span>木</span><span>金</span><span class="sat">土</span><span class="sun">日</span></div>
          <div id="calendar" class="calendar-grid" role="group" aria-label="導入日カレンダー"></div>
        </div>
        <div class="calendar-key"><span><i></i>導入予定日</span><span>日付は変更される場合があります</span></div>
      </div>

      <section class="release-section" aria-labelledby="release-title">
        <div class="lineup-heading">
          <p class="cal-kicker" id="lineup-kicker">この月に入る新台</p>
          <h2 id="release-title">今月の掲載ラインナップ</h2>
          <span id="lineup-count"></span>
        </div>
        <div id="releases"></div>
      </section>
      <div id="empty" class="empty" hidden><img src={url("editorial/calendar/search.svg")} alt=""><h3>条件に合う機種が見つかりませんでした</h3><p id="empty-description">機種名の一部やメーカー名で検索するか、絞り込みを解除してください。</p><button type="button" id="reset-filters" class="text-button">絞り込みを解除</button></div>

      <p class="cal-disclaimer">日付は掲載情報に基づく導入予定・導入時期の目安です。変更される場合があり、地域・ホールによっても異なります。正確な設置状況は各ホールへご確認ください。</p>

      <section class="next-months" aria-labelledby="other-title">
        <h2 id="other-title">ほかの導入月を見る</h2>
        <div id="related-months"></div>
      </section>

      <section class="cal-app" aria-labelledby="app-title">
        <p class="cal-kicker" id="app-title">調べた機種を、次の記録へ。</p>
        <div class="cta-pair">
          <a class="store-badge" href={APP_STORE_URL_JP} target="_blank" rel="noopener" aria-label="App Storeからダウンロード"><img src={url("editorial/assets/badge-appstore.svg")} alt="App Storeからダウンロード" width="196" height="72"></a>
          <a class="cta-orange" href={url('machines/')}><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.2" y="1.8" width="15.6" height="20.8" rx="2" ry="2"/><path d="M8 15.4h0"/><path d="M12 15.4h0"/><path d="M16 15.4h0"/><line x1="5.2" y1="5.8" x2="19.3" y2="5.8"/><line x1="5.2" y1="12.8" x2="19.3" y2="12.8"/><line x1="5.2" y1="18.2" x2="19.3" y2="18.2"/><line x1="9.4" y1="6.6" x2="9.4" y2="12.7"/><line x1="14.8" y1="6.4" x2="14.8" y2="12.6"/></svg><span>機種一覧を見る</span></a>
        </div>
      </section>
    </div>
    <noscript><p class="cal-noscript">カレンダーの操作にはJavaScriptが必要です。機種一覧からも掲載情報をご覧いただけます。<a href={url('machines/')}>機種一覧を見る</a></p></noscript>
  </div>
  <script is:inline set:html={boot}></script>
  <script is:inline defer src={url('editorial/calendar.js')}></script>
</Editorial>
