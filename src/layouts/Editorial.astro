---
import Header from '../components/editorial/Header.astro';
import Footer from '../components/editorial/Footer.astro';
import {url} from '../lib/url';
interface Props { title: string; description?: string; socialImage?: string | null; home?: boolean; }
const {title, description='記録から、判断へ。スロログはパチスロの記録・分析・立ち回りをつなぐアプリです。', socialImage='og.jpg', home=false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// CSSのキャッシュ対策：ビルドごとに変わる印を付けて、公開後に古い見た目が残らないようにする
const assetVer = String(Date.now()).slice(-8);
const ogImage = socialImage ? new URL(url(socialImage), Astro.site ?? Astro.url).href : null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbfc" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={url('editorial/assets/app-icon.webp')} />
    <link rel="stylesheet" href={`${url('editorial/styles.css')}?v=${assetVer}`} />
    {!home && <link rel="stylesheet" href={`${url('editorial/pages.css')}?v=${assetVer}`} />}
    <script is:inline type="module" src={url('editorial/app.js')}></script>
    {!home && <script is:inline defer src={url('editorial/pages.js')}></script>}
  </head>
  <body class:list={{subpage:!home}}>
    <a class="skip" href="#main">本文へ</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
