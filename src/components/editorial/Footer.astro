---
import {url} from '../../lib/url';
import {SOCIALS, SOCIAL_ICONS} from '../../lib/social';
const socials = SOCIALS.filter(s => s.url);
---
<footer><a class="brand" href={url("")}><img src={url("editorial/assets/logo.png")} alt="スロログ" width="160" height="53"></a><div><a href={url("privacy/")}>プライバシーポリシー</a><a href={url("terms/")}>利用規約</a><a href="mailto:respecthq.dev@gmail.com">サポート</a></div>{socials.length > 0 && <ul class="social" aria-label="公式SNS">{socials.map(s => <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><span set:html={SOCIAL_ICONS[s.key]} /></a></li>)}</ul>}<small>© 2026 Re:Spect / 回胴キナナ</small></footer>
<style>
  .social{list-style:none;display:flex;gap:10px;margin:0;padding:0}
  .social a{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border:1px solid #d4d7dc;border-radius:50%;color:#111216;transition:background .18s,color .18s,border-color .18s}
  .social a:hover{background:#111216;color:#fff;border-color:#111216}
  .social svg{width:18px;height:18px}
</style>
